# GOD EYES — normalizer environment example (placeholders only; never commit real secrets).
# Copy to services/normalizer/.env for local development. .env files are gitignored.
#
# All Python normalizer scripts under services/normalizer/ read these via os.environ / os.getenv.
# Optional variables can be left blank; the normalizer scripts fall back to module-level DEFAULT_*
# placeholders (which point at local docker-compose endpoints), so this file is only needed when
# overriding defaults.

# ---------------------------------------------------------------------------------------------
# Postgres (required)
# ---------------------------------------------------------------------------------------------
# Required by every normalizer that writes back to aviation tables. Used by
# services/normalizer/src/layers/layer_01_aviation/ourairports_normalizer.py and any other
# aviation normalizer module that reads raw_objects metadata. Empty / unset -> module default.
DATABASE_URL=postgresql://god_eyes:god_eyes_dev_password@localhost:5432/god_eyes_dev

# ---------------------------------------------------------------------------------------------
# MinIO raw object storage (required for reading raw archive writes from the fetch-orchestrator)
# ---------------------------------------------------------------------------------------------
# Used by services/normalizer/src/layers/layer_01_aviation/ourairports_normalizer.py to load the
# raw CSVs uploaded by the fetch-orchestrator collector. Defaults are local docker-compose endpoints.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=god_eyes_minio_dev
MINIO_SECRET_KEY=replace_with_dev_secret
MINIO_BUCKET=god-eyes-raw
