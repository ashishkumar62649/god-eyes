# GOD EYES — fetch-orchestrator environment example (placeholders only; never commit real secrets).
# Copy to services/fetch-orchestrator/.env for local development. .env files are gitignored.
#
# All Python worker scripts under services/fetch-orchestrator/ read these via os.environ / os.getenv.
# Optional variables can be left blank; the worker scripts fall back to module-level DEFAULT_* placeholders
# (which point at local docker-compose endpoints), so this file is only needed when overriding defaults
# or supplying real third-party API credentials.

# ---------------------------------------------------------------------------------------------
# Postgres (required)
# ---------------------------------------------------------------------------------------------
# Required by every layer's *_db.py / *_worker.py module (aviation, borders, earth events, space,
# maritime, weather, news, energy). The service-side DEFAULT_DATABASE_URL falls back to the same
# localhost PostGIS instance used by the API. Empty / unset -> module default.
DATABASE_URL=postgresql://god_eyes:god_eyes_dev_password@localhost:5432/god_eyes_dev

# ---------------------------------------------------------------------------------------------
# MinIO raw object storage (required for aviation OurAirports + raw archive writes)
# ---------------------------------------------------------------------------------------------
# Used by ourairports_collector.py to upload raw CSVs and by other layer workers that write
# raw payloads to the raw bucket. Defaults are local docker-compose endpoints.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=god_eyes_minio_dev
MINIO_SECRET_KEY=replace_with_dev_secret
MINIO_BUCKET=god-eyes-raw

# ---------------------------------------------------------------------------------------------
# Maritime (optional — only required for live AISStream fetches)
# ---------------------------------------------------------------------------------------------
# Used by services/fetch-orchestrator/src/layers/layer_06_maritime/aisstream_client.py and
# aisstream_proof.py. Leave blank to keep maritime in dry-run / disabled mode.
AISSTREAM_API_KEY=replace-me

# ---------------------------------------------------------------------------------------------
# Space-Track.org (optional — only required for live space-satellite TLE pulls)
# ---------------------------------------------------------------------------------------------
# Used by services/fetch-orchestrator/src/layers/layer_05_space_satellites/space_track_client.py.
# Register at https://www.space-track.org/ and supply your account credentials here. Leave blank
# to keep the space-track fetcher disabled (CelesTrak remains available without credentials).
SPACE_TRACK_USERNAME=replace-me
SPACE_TRACK_PASSWORD=replace-me
