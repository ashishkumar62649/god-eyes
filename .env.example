# GOD EYES — root environment example (placeholders only; never commit real secrets).
# Copy to .env for local development. .env is gitignored.
#
# Backend / data services read: API_PORT, DATABASE_URL, NODE_ENV, POSTGRES_*, MINIO_*.
# Frontend (Vite) variables live in apps/web/.env — see apps/web/.env.example:
#   VITE_CESIUM_ION_ACCESS_TOKEN  (Cesium ion token; matches apps/web code)
#   VITE_API_BASE_URL             (API base URL used by frontend clients)

API_PORT=4000
DATABASE_URL=postgresql://god_eyes:god_eyes_dev_password@localhost:5432/god_eyes_dev
NODE_ENV=development
POSTGRES_DB=god_eyes_dev
POSTGRES_USER=god_eyes
POSTGRES_PASSWORD=god_eyes_dev_password

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=god_eyes_minio_dev
MINIO_SECRET_KEY=replace_with_dev_secret
MINIO_BUCKET=god-eyes-raw
