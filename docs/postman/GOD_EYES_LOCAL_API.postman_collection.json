{
  "info": {
    "name": "GOD EYES Local API",
    "description": "API endpoints for GOD EYES World Intelligence Globe project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "objectId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Layers",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/layers",
          "host": ["{{baseUrl}}"],
          "path": ["api", "layers"]
        }
      }
    },
    {
      "name": "Aviation Layer Status",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/layers/layer_01_aviation/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "layers", "layer_01_aviation", "status"]
        }
      }
    },
    {
      "name": "Aviation Airports",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/layers/layer_01_aviation/objects?objectType=airport&limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["api", "layers", "layer_01_aviation", "objects"],
          "query": [
            {
              "key": "objectType",
              "value": "airport"
            },
            {
              "key": "limit",
              "value": "50"
            }
          ]
        }
      }
    },
    {
      "name": "Aviation Airports by Country",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/layers/layer_01_aviation/objects?objectType=airport&country=US&limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["api", "layers", "layer_01_aviation", "objects"],
          "query": [
            {
              "key": "objectType",
              "value": "airport"
            },
            {
              "key": "country",
              "value": "US"
            },
            {
              "key": "limit",
              "value": "50"
            }
          ]
        }
      }
    },
    {
      "name": "Aviation Airport Search",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/layers/layer_01_aviation/objects?objectType=airport&search=Dubai&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "layers", "layer_01_aviation", "objects"],
          "query": [
            {
              "key": "objectType",
              "value": "airport"
            },
            {
              "key": "search",
              "value": "Dubai"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Aviation Airport Detail",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/layers/layer_01_aviation/objects/{{objectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "layers", "layer_01_aviation", "objects", "{{objectId}}"]
        }
      }
    }
  ]
}